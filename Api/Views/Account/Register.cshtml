@model MeetingBooking.Api.Models.RegisterViewModel
<h2>Register</h2>
<div class="surface-card form-narrow">
    <form asp-action="Register" method="post">
        <div class="mb-3">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" placeholder="Your full name" />
        </div>
        <div class="mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="you@company.com" />
        </div>
        <div class="mb-3">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" placeholder="At least 8 characters" />
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">Register</button>
        <p class="mt-3 mb-0">Already have an account? <a asp-action="Login">Login here</a></p>
    </form>
</div>