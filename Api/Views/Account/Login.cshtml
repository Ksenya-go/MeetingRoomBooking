@model MeetingBooking.Api.Models.LoginViewModel
<h2>Login</h2>
<div class="surface-card form-narrow">
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="you@company.com" />
        </div>
        <div class="mb-3">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" placeholder="Your password" />
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">Login</button>
        <p class="mt-3 mb-0">Don't have an account? <a asp-action="Register">Register here</a></p>
    </form>
</div>