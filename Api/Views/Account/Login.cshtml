@model MeetingBooking.Api.Models.LoginViewModel
<h2 class="text-center">@Localizer["Account_LoginTitle"]</h2>
<div class="surface-card form-narrow mx-auto mt-5">
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label asp-for="Email">@Localizer["Account_EmailLabel"]</label>
            <input asp-for="Email" class="form-control" placeholder="@Localizer["Account_EmailPlaceholder"]" />
        </div>
        <div class="mb-3">
            <label asp-for="Password">@Localizer["Account_PasswordLabel"]</label>
            <input asp-for="Password" class="form-control" placeholder="@Localizer["Account_LoginPasswordPlaceholder"]" />
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">@Localizer["Account_LoginButton"]</button>
        <p class="mt-3 mb-0">@Localizer["Account_NoAccountPrompt"] <a asp-action="Register">@Localizer["Account_RegisterLink"]</a></p>
    </form>
</div>