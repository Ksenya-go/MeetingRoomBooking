@model MeetingBooking.Application.Resources.UpdateResourceCommand
<h2>Edit Resource</h2>
<div class="surface-card form-narrow">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label>Room name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Conference Room A" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <input asp-for="Description" class="form-control" placeholder="Optional details about this room" />
        </div>
        <div class="mb-3">
            <label>Capacity</label>
            <input asp-for="Capacity" type="number" min="1" class="form-control" placeholder="Number of people it seats" />
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>