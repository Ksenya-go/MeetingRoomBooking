@inject IStringLocalizer<SharedResource> Localizer
@model MeetingBooking.Application.Resources.Commands.CreateResourceCommand
<h2>@Localizer["MeetingRooms_CreateTitle"]</h2>
<div class="surface-card form-narrow">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label>@Localizer["MeetingRooms_Name"]</label>
            <input name="Name" class="form-control" placeholder="@Localizer["Resources_RoomExamplePlaceholder"]" />
        </div>
        <div class="mb-3">
            <label>@Localizer["MeetingRooms_Description"]</label>
            <input name="Description" class="form-control" placeholder="@Localizer["Resources_DescriptionPlaceholder"]" />
            <div class="form-text text-muted">@Localizer["Resources_DescriptionHelp"]</div>
        </div>
        <div class="mb-3">
            <label>@Localizer["MeetingRooms_Capacity"]</label>
            <input name="Capacity" type="number" min="1" class="form-control" placeholder="@Localizer["Resources_CapacityPlaceholder"]" />
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">@Localizer["Common_CreateButton"]</button>
    </form>
</div>