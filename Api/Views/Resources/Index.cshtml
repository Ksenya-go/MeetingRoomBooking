@inject IStringLocalizer<SharedResource> Localizer
@model X.PagedList.IPagedList<MeetingBooking.Application.Resources.ResourceDto>
<h2>@Localizer["MeetingRooms_PageTitle"]</h2>
@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">@Localizer["MeetingRooms_AddButton"]</a>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<table class="table">
    <thead>
        <tr class="text-center">
            <th>@Localizer["MeetingRooms_Name"]</th>
            <th>@Localizer["MeetingRooms_Capacity"]</th>
            <th>@Localizer["MeetingRooms_Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr class="text-center">
                <td>@r.Name</td>
                <td>@r.Capacity</td>
                <td>
                    <a asp-controller="Bookings" asp-action="Schedule" asp-route-resourceId="@r.Id" class="btn btn-sm btn-primary">@Localizer["Booking_ScheduleButton"]</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-secondary">@Localizer["MeetingRooms_EditButton"]</a>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger">@Localizer["Common_DeleteButton"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalItemCount / Model.PageSize);
}
<nav class="d-flex justify-content-center pagination-wrapper">
    <ul class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
            </li>
        }
    </ul>
</nav>