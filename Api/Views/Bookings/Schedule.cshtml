@model MeetingBooking.Application.Bookings.ResourceScheduleDto

<h2>@Model.ResourceName — @Model.Date.ToString("dd.MM.yyyy")</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="mb-3 d-flex gap-2 align-items-end">
    <input type="hidden" name="resourceId" value="@Model.ResourceId" />
    <div>
        <label>Date</label>
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <button type="submit" class="btn btn-secondary">Show</button>
</form>

<table class="table" id="scheduleTable">
    <thead><tr><th>Time</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var slot in Model.Slots)
        {
            <tr data-timeslot-id="@slot.TimeSlotId">
                <td>@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</td>
                <td class="status-cell">
                    @if (slot.IsBooked)
                    {
                        <span class="badge bg-danger">Booked</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Free</span>
                    }
                </td>
                <td>
                    @if (!slot.IsBooked)
                    {
                        <form asp-action="Book" method="post" style="display:inline">
                            <input type="hidden" name="resourceId" value="@Model.ResourceId" />
                            <input type="hidden" name="timeSlotId" value="@slot.TimeSlotId" />
                            <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-sm btn-primary">Book</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>